server {
    listen 127.0.0.1:8080;
    server_name localhost;
    root /opt/fabric-scanner/ui;
    index station.html;
    client_max_body_size 2m;
    resolver __DNS_RESOLVER__ valid=10s ipv6=off;
    set $api_origin "__API_ORIGIN__";

    # The file:// starting screen polls only this read-only local readiness marker.
    # Origin null is the file origin; no credentialed API endpoint receives CORS.
    location = /station/ready {
        if ($request_method != GET) { return 405; }
        try_files /station.html =503;
        add_header Access-Control-Allow-Origin "null" always;
        add_header Cache-Control "no-store" always;
    }

    location = /station/heartbeat {
        client_max_body_size 1k;
        proxy_pass http://127.0.0.1:8765/heartbeat;
        proxy_connect_timeout 1s;
        proxy_read_timeout 2s;
        add_header Cache-Control "no-store" always;
    }
    # Exit kiosk mode (Station settings, three confirmations). nginx listens on loopback only,
    # so this is reachable from the Pi's own screen, never from the LAN. A reboot re-enters kiosk mode.
    location = /station/exit {
        limit_except POST { deny all; }
        client_max_body_size 1k;
        proxy_pass http://127.0.0.1:8765/exit;
        proxy_connect_timeout 1s;
        proxy_read_timeout 2s;
        add_header Cache-Control "no-store" always;
    }
    location = /station/input/events {
        proxy_pass http://127.0.0.1:8766/events;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 1s;
        proxy_read_timeout 1h;
        add_header Cache-Control "no-store" always;
    }
    location = /station/input/status {
        proxy_pass http://127.0.0.1:8766/status;
        proxy_connect_timeout 1s;
        proxy_read_timeout 2s;
        add_header Cache-Control "no-store" always;
    }
    location ~ ^/api(?:/|$) {
        proxy_pass $api_origin;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
        # Only with an upstream group (render-nginx.py): move on to the local-network address
        # when the main one cannot be reached. POSTs that may have arrived are never re-sent.
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
        add_header X-Fabric-Upstream $upstream_addr always;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        add_header Cache-Control "no-store" always;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }
}

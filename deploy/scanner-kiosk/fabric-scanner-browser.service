[Unit]
Description=Fabric scanner kiosk browser
PartOf=fabric-scanner.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=KIOSK_URL=http://127.0.0.1:8080/station.html?station=shared-door#kiosk
EnvironmentFile=-/opt/fabric-scanner/station.env
ExecStart=/opt/fabric-scanner/bin/browser.sh
Restart=always
RestartSec=3
